# Discord Bot Configuration
DISCORD_TOKEN=your_bot_token_here
CLIENT_ID=your_client_id_here
GUILD_ID=your_guild_id_here

# Database Configuration
DATABASE_PATH=./database/bot.db

# Voice Welcome Configuration
# Fallback channel ID if not set in guild_settings
CHANNEL_ID=your_welcome_voice_channel_id_here

# YouTube Upload Poller Configuration
# Optional channel ID override for video upload notifications
YOUTUBE_NOTIFICATION_CHANNEL_ID=
# Optional role ID to mention on new video upload (leave blank for @everyone)
YOUTUBE_NOTIFICATION_ROLE_ID=


